# Cyber AI Orchestrator — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit real secrets.

# ==================== CORE ====================
# Optional: absolute path to the CERBERUS workspace root. All relative paths
# (targets file, memory DBs, logs, evidence) resolve against this directory.
# When unset, the repository root is used.
# CERBERUS_HOME=/opt/cerberus

# Platform name
PLATFORM_NAME=Cyber AI Orchestrator
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ==================== OLLAMA ====================
# Local model service
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ==================== LITELLM GATEWAY ====================
# Master key for the LiteLLM proxy (generate a random strong value)
LITELLM_MASTER_KEY=
# LiteLLM proxy port
LITELLM_PORT=4000
# LiteLLM config file path
LITELLM_CONFIG_PATH=cyberai/llm-gateway/config/config.yaml

# ==================== CLOUD LLM PROVIDERS (OPTIONAL) ====================
# Only add keys if you want to use cloud providers through the gateway
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ==================== OPEN WEBUI ====================
# Human-facing interface
OPEN_WEBUI_PORT=3000
# Bind to localhost only by default for security
OPEN_WEBUI_HOST=127.0.0.1

# ==================== PENTAGI ====================
# PENTAGI_API_URL=https://localhost:8443
# PENTAGI_API_TOKEN=

# ==================== MEMORY ====================
# SQLite database for memory storage
MEMORY_DB_PATH=memory/memory.db
# Embeddings model for semantic retrieval (via Ollama)
EMBEDDINGS_MODEL=nomic-embed-text

# ==================== LAB ====================
# Authorized lab targets file
LAB_TARGETS_PATH=lab/targets/targets.yaml
# Default lab network
LAB_NETWORK=cyber-lab-net

# ==================== SECURITY ====================
# Comma-separated list of allowed hosts for the orchestrator (default: localhost)
ALLOWED_HOSTS=127.0.0.1,localhost
# Require explicit target authorization (true/false)
REQUIRE_TARGET_AUTHORIZATION=true
